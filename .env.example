# העתיקו קובץ זה ל-.env ומלאו את הערכים המתאימים למחשב שלכם

# כתובת החיבור למסד הנתונים המקומי (ראו הוראות התקנה ב-README)
MONGODB_URI=mongodb://127.0.0.1:27017/the-daily-web

# פורט השרת
PORT=3000

# סוד להצפנת ה-session (החליפו למחרוזת אקראית משלכם)
SESSION_SECRET=change-this-to-a-long-random-string

# מפתח API חינמי מ-OpenWeatherMap (https://openweathermap.org/api)
# ההרשמה חינמית ולא דורשת פרטי אשראי. בלי מפתח - הווידג'ט יציג הודעת "לא זמין".
WEATHER_API_KEY=
# שם העיר שנשלח בפועל ל-API - חייב להיות באנגלית כדי שהשירות החיצוני יזהה אותו
WEATHER_CITY=Tel Aviv,IL
# שם העיר כפי שיוצג למשתמש באתר (בעברית) - נפרד מהשם שנשלח ל-API
WEATHER_CITY_HE=תל אביב

# NODE_ENV=production מכבה לוגים מפורטים של פיתוח
NODE_ENV=development

# רמת הלוג: info (הכל) | warn (אזהרות ושגיאות) | error (שגיאות בלבד)
LOG_LEVEL=info

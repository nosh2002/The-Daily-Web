<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <main class="page page-review" data-article-id="<%= article._id %>">
    <div class="dashboard-header">
      <h1>בדיקת כתבה</h1>
      <span class="status-badge status-<%= article.status %>"><%= STATUS_LABELS_HE[article.status] %></span>
    </div>

    <p class="article-byline">כתב: <strong><%= article.author ? article.author.displayName : '—' %></strong></p>

    <% if (article.published && article.published.isPublished) { %>
      <details class="published-diff-box" open>
        <summary>התוכן המפורסם כרגע לציבור (גרסה <%= article.published.publishedByVersion %>) - להשוואה מול התוכן החדש שבטופס למטה</summary>
        <h3><%= article.published.title %></h3>
        <p><em><%= article.published.summary %></em></p>
        <div class="published-body-preview"><%= article.published.body %></div>
      </details>
    <% } %>

    <form id="reviewForm" class="article-edit-form">
      <label for="title">כותרת (בבדיקה)</label>
      <input type="text" id="title" name="title" value="<%= article.content.title %>" maxlength="200" />

      <label for="summary">תקציר</label>
      <textarea id="summary" name="summary" rows="2" maxlength="400"><%= article.content.summary %></textarea>

      <div class="form-row">
        <div>
          <label for="category">קטגוריה</label>
          <select id="category" name="category">
            <% categories.forEach(function(cat) { %>
              <option value="<%= cat %>" <%= cat === article.content.category ? 'selected' : '' %>><%= cat %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label for="imageUrl">כתובת תמונה (URL)</label>
          <input type="text" id="imageUrl" name="imageUrl" value="<%= article.content.imageUrl %>" />
        </div>
      </div>

      <label for="body">תוכן הכתבה</label>
      <textarea id="body" name="body" rows="16"><%= article.content.body %></textarea>

      <p id="formMessage" class="form-message" role="status"></p>
    </form>

    <div class="review-actions">
      <button type="button" id="saveBtn" class="btn btn-secondary">שמירת שינויי עריכה</button>
      <button type="button" id="approveBtn" class="btn btn-primary">אישור ופרסום</button>
      <button type="button" id="deleteBtn" class="btn btn-danger">מחיקת כתבה</button>
    </div>

    <div class="return-box">
      <label for="returnNote">הערה להחזרת הכתבה לתיקונים</label>
      <textarea id="returnNote" rows="3" placeholder="פרטו אילו תיקונים נדרשים…"></textarea>
      <button type="button" id="returnBtn" class="btn btn-warning">החזרה לכתב לתיקונים</button>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/editor.js"></script>
</body>
</html>
